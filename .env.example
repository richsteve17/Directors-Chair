# Copy to .env.local and fill in. Used by the Vercel function (api/message.js).
# The key stays server-side and is NEVER bundled into the browser.

# Required: your Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK=gemini-2.0-flash,gemini-1.5-flash
# MAX_TOKENS=1200
# TEMPERATURE=1.0
